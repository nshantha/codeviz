{
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron": "^37.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "description": "AlgoMentor — local-first interview prep desktop app (Electron + React + SQLite)",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "main": "dist/main/index.js",
  "name": "algomentor",
  "private": true,
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:data",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "seed:catalog": "node scripts/gen-catalog-seed.mjs",
    "test": "node --test dist-test/ 2>/dev/null || echo 'no tests yet'",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:data": "mkdir -p dist/main/data dist/assets && cp src/main/data/catalog.json dist/main/data/catalog.json && cp assets/icon.png dist/assets/icon.png",
    "postinstall": "electron-rebuild -w better-sqlite3"
  },
  "version": "0.1.0",
  "build": {
    "appId": "com.algomentor.app",
    "productName": "AlgoMentor",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.education"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Education"
    }
  }
}
